{
    "label": "lock",
    "action": "loginctl lock-session",
    "text": "Lock",
    "keybind": "l"
}
{
    "label": "logout",
    "action": "hyprshutdown",
    "text": "Log out",
    "keybind": "e"
}
{
    "label": "suspend",
    "action": "systemctl suspend",
    "text": "Suspend",
    "keybind": "s"
}
{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "Restart",
    "keybind": "r"
}
{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "Shut down",
    "keybind": "p"
}
