#!/usr/bin/env bash
set -euo pipefail

state=${XDG_RUNTIME_DIR:-/tmp}/hyprland-effects-disabled
if [[ -e $state ]]; then
    hyprctl eval 'hl.config({ animations = { enabled = true } })' >/dev/null
    rm -f "$state"
    notify-send "Hyprland effects" "Animations enabled"
else
    hyprctl eval 'hl.config({ animations = { enabled = false } })' >/dev/null
    : >"$state"
    notify-send "Hyprland effects" "Animations disabled"
fi
