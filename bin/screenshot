#!/usr/bin/env bash
set -euo pipefail

picture_dir=$(xdg-user-dir PICTURES 2>/dev/null || printf '%s' "$HOME")
output_dir=$picture_dir/Screenshots
mkdir -p "$output_dir"
output=$output_dir/$(date +%Y%m%d_%H%M%S).png
geometry=$(slurp) || exit 0
grim -g "$geometry" - | satty -f - --copy-command wl-copy -o "$output"
