#!/usr/bin/env bash
set -euo pipefail

config_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
required=(bash cal jq luac rofi wpctl xdg-user-dir)
session_required=(
    Hyprland hyprctl waybar hyprlock hypridle hyprpaper grim slurp satty
    wl-copy wl-paste cliphist brightnessctl dunstctl notify-send alacritty brave
    thunar thunderbird signal-desktop slack zoom code nm-applet blueman-applet
    pavucontrol xfce4-taskmanager hyprshutdown
)

missing=()
for command in "${required[@]}" "${session_required[@]}"; do
    command -v "$command" >/dev/null || missing+=("$command")
done
if (( ${#missing[@]} )); then
    printf 'Missing commands: %s\n' "${missing[*]}" >&2
    exit 1
fi

luac -p "$config_dir/hyprland.lua" "$config_dir"/lua/*.lua
for script in "$config_dir"/bin/*; do
    bash -n "$script"
done
jq empty "$config_dir/waybar/config.jsonc"
if command -v desktop-file-validate >/dev/null; then
    desktop-file-validate "$config_dir"/applications/*.desktop
fi

waybar_config=$(readlink -f "$HOME/.config/waybar" 2>/dev/null || true)
if [[ $waybar_config != "$config_dir/waybar" ]]; then
    echo "Waybar configuration is not linked to $config_dir/waybar" >&2
    exit 1
fi

for service in waybar hyprpaper hypridle hyprpolkitagent; do
    service_link="$HOME/.config/systemd/user/graphical-session.target.wants/$service.service"
    if [[ ! -L $service_link ]]; then
        echo "$service.service is not enabled for graphical-session.target" >&2
        exit 1
    fi
done

if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    errors=$(hyprctl configerrors)
    [[ -z $errors ]] || { printf '%s\n' "$errors" >&2; exit 1; }
    if pgrep -x Xwayland >/dev/null; then
        echo "XWayland is running in a native-only session" >&2
        exit 1
    fi
    if hyprctl clients -j | jq -e 'any(.[]; .xwayland == true)' >/dev/null; then
        echo "At least one XWayland client is running" >&2
        exit 1
    fi
fi

echo "Hyprland configuration checks passed"
