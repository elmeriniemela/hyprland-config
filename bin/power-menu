#!/usr/bin/env bash
set -euo pipefail

config_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
read -r output_width output_height < <(
    hyprctl monitors -j |
        jq -r '.[] | select(.focused) | [(.width / .scale | floor), (.height / .scale | floor)] | @tsv'
)

dialog_width=1100
dialog_height=320
(( output_width < dialog_width + 64 )) && dialog_width=$((output_width - 64))
(( output_height < dialog_height + 64 )) && dialog_height=$((output_height - 64))

horizontal_margin=$(((output_width - dialog_width) / 2))
vertical_margin=$(((output_height - dialog_height) / 2))

exec wlogout \
    --layout "$config_dir/wlogout/layout" \
    --css "$config_dir/wlogout/style.css" \
    --protocol layer-shell \
    --no-span \
    --buttons-per-row 5 \
    --column-spacing 12 \
    --margin-left "$horizontal_margin" \
    --margin-right "$horizontal_margin" \
    --margin-top "$vertical_margin" \
    --margin-bottom "$vertical_margin"
