#!/usr/bin/env bash
set -euo pipefail

runtime=${XDG_RUNTIME_DIR:-/tmp}
state=$runtime/hyprland-minimized.tsv
touch "$state"

clean_state() {
    local alive cleaned
    alive=$(mktemp "$runtime/hyprland-minimized-alive.XXXXXX")
    cleaned=$(mktemp "$runtime/hyprland-minimized-clean.XXXXXX")
    hyprctl clients -j | jq -r '.[].address' >"$alive"
    awk -F '\t' 'NR == FNR { alive[$1] = 1; next } alive[$1]' "$alive" "$state" >"$cleaned"
    mv "$cleaned" "$state"
    rm -f "$alive"
}

case "${1:-}" in
    minimize)
        window=$(hyprctl activewindow -j)
        address=$(jq -r '.address // empty' <<<"$window")
        workspace=$(jq -r '.workspace.id // empty' <<<"$window")
        [[ $address =~ ^0x[0-9a-fA-F]+$ && $workspace =~ ^[0-9]+$ ]] || exit 0
        class=$(jq -r '.class // "window"' <<<"$window" | tr '\t\n' '  ')
        title=$(jq -r '.title // ""' <<<"$window" | tr '\t\n' '  ')
        clean_state
        if ! grep -q "^${address}"$'\t' "$state"; then
            printf '%s\t%s\t%s\t%s\n' "$address" "$workspace" "$class" "$title" >>"$state"
        fi
        hyprctl dispatch "hl.dsp.window.move({ window = \"address:$address\", workspace = \"special:minimized\", follow = false })"
        ;;
    restore)
        clean_state
        selection=$(awk -F '\t' '{ printf "%s\t[%s] %s — %s\n", $1, $2, $3, $4 }' "$state" | rofi -dmenu -i -p Minimized) || exit 0
        address=${selection%%$'\t'*}
        [[ $address =~ ^0x[0-9a-fA-F]+$ ]] || exit 0
        workspace=$(awk -F '\t' -v address="$address" '$1 == address { print $2; exit }' "$state")
        [[ $workspace =~ ^[0-9]+$ ]] || exit 1
        hyprctl dispatch "hl.dsp.window.move({ window = \"address:$address\", workspace = \"$workspace\", follow = true })"
        cleaned=$(mktemp "$runtime/hyprland-minimized-clean.XXXXXX")
        awk -F '\t' -v address="$address" '$1 != address' "$state" >"$cleaned"
        mv "$cleaned" "$state"
        ;;
    status)
        clean_state
        count=$(awk 'END { print NR + 0 }' "$state")
        if (( count == 0 )); then
            jq -cn '{text:"", tooltip:"No minimized windows", class:"empty"}'
        else
            jq -cn --arg count "$count" '{text:$count, tooltip:($count + " minimized window(s); click to restore"), class:"occupied"}'
        fi
        ;;
    *)
        echo "usage: minimized-windows {minimize|restore|status}" >&2
        exit 2
        ;;
esac
