#!/usr/bin/env bash
set -euo pipefail

hyprctl reload
sleep 0.5
monitors=$(hyprctl monitors -j)

if ! jq -e '
    def pixels:
        capture("^(?<width>[0-9]+)x(?<height>[0-9]+)@")
        | (.width | tonumber) * (.height | tonumber);
    all(.[ ];
        (.availableModes // [] | map(pixels) | max) as $maximum
        | $maximum == null or (.width * .height) == $maximum
    )
' <<<"$monitors" >/dev/null; then
    notify-send -u critical "Monitor layout" "A display is not using its maximum resolution"
    exit 1
fi

if jq -e 'any(.[]; (.description // "") | contains("ASUS MG28U"))' <<<"$monitors" >/dev/null; then
    if ! jq -e '
        any(.[];
            ((.description // "") | contains("ASUS MG28U"))
            and .width == 3840 and .height == 2160
            and .x == 0 and .y == 0
            and (.scale - 1 | fabs) < 0.01
        )
        and any(.[]; .name == "eDP-1" and .x == 960 and .y == 2160)
    ' <<<"$monitors" >/dev/null; then
        notify-send -u critical "Monitor layout" "The ASUS/laptop stacked layout does not match configuration"
        exit 1
    fi
fi

notify-send "Monitor layout" "Display configuration applied"
