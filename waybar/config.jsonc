[
  {
    "name": "top",
    "layer": "top",
    "position": "top",
    "height": 20,
    "spacing": 4,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["battery", "wireplumber", "custom/notifications", "tray"],
    "hyprland/workspaces": {
      "format": "{name}",
      "all-outputs": true,
      "persistent-workspaces": {
        "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
      }
    },
    "clock": {
      "format": " {:%H:%M}",
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "on-click": "$HOME/.config/hypr/bin/calendar-popup",
      "calendar": {
        "mode": "month",
        "weeks-pos": "left",
        "on-scroll": 1
      }
    },
    "battery": {
      "format": "{icon} {capacity}%",
      "format-charging": " {capacity}%",
      "format-plugged": " {capacity}%",
      "format-icons": ["", "", "", "", ""],
      "states": { "warning": 20, "critical": 10 }
    },
    "wireplumber": {
      "format": "{icon} {volume}%",
      "format-muted": " muted",
      "format-icons": ["", "", ""],
      "on-click": "pavucontrol",
      "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "custom/notifications": {
      "exec": "$HOME/.config/hypr/bin/notification-status",
      "return-type": "json",
      "interval": "once",
      "on-click": "dunstctl set-paused toggle"
    },
    "tray": {
      "icon-size": 16,
      "spacing": 5
    }
  },
  {
    "name": "bottom",
    "layer": "top",
    "position": "bottom",
    "height": 20,
    "spacing": 4,
    "modules-left": ["custom/power"],
    "modules-center": ["wlr/taskbar"],
    "modules-right": [],
    "custom/power": {
      "format": "",
      "tooltip": true,
      "tooltip-format": "Session menu",
      "on-click": "$HOME/.config/hypr/bin/power-menu"
    },
    "wlr/taskbar": {
      "format": "{icon} {title}",
      "icon-size": 14,
      "all-outputs": false,
      "active-first": true,
      "on-click": "minimize-raise",
      "on-click-middle": "close"
    }
  }
]
