[
  {
    "name": "top",
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["battery", "wireplumber", "custom/notifications", "tray"],
    "hyprland/workspaces": {
      "format": "{name}",
      "all-outputs": true,
      "disable-click": false,
      "move-to-monitor": true,
      "on-click": "activate",
      "persistent-workspaces": {
        "*": [1, 2, 3, 4, 5, 6, 7, 8, 9]
      }
    },
    "clock": {
      "format": "{:%a %d %b  %H:%M}",
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "calendar": {
        "mode": "month",
        "weeks-pos": "left",
        "on-scroll": 1,
        "iso8601": true
      },
      "actions": {
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
      }
    },
    "battery": {
      "format": "BAT  {capacity}%",
      "format-charging": "CHG  {capacity}%",
      "format-plugged": "AC  {capacity}%",
      "states": { "warning": 20, "critical": 10 }
    },
    "wireplumber": {
      "format": "VOL  {volume}%",
      "format-muted": "MUTED",
      "on-click": "pavucontrol",
      "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "custom/notifications": {
      "exec": "$HOME/.config/hypr/bin/notification-status",
      "return-type": "json",
      "interval": "once",
      "on-click": "dunstctl set-paused toggle"
    },
    "tray": {
      "icon-size": 17,
      "spacing": 8
    }
  },
  {
    "name": "bottom",
    "layer": "top",
    "position": "bottom",
    "height": 28,
    "spacing": 0,
    "modules-left": ["custom/power"],
    "modules-center": ["wlr/taskbar"],
    "modules-right": [],
    "custom/power": {
      "format": "POWER",
      "tooltip": true,
      "tooltip-format": "Session and power actions",
      "on-click": "$HOME/.config/hypr/bin/power-menu"
    },
    "wlr/taskbar": {
      "format": "{icon} {title}",
      "icon-size": 16,
      "all-outputs": false,
      "active-first": true,
      "on-click": "minimize-raise",
      "on-click-middle": "close"
    }
  }
]
